{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",

        "jsx": "react-jsx",

        "allowJs": true,
        "noEmit": true,

        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        "strict": true,
        "noImplicitAny": true,

        "skipLibCheck": true,

        "paths": {
            "@/*": ["./resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        }
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx"
    ]
}