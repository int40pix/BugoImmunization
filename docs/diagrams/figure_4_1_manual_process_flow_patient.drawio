<mxfile host="app.diagrams.net" modified="2026-09-22T10:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="manual_flow_patient" name="Figure 4.1 Manual Process Flow for Parent and Patient">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header Title -->
        <mxCell id="title" value="Figure 4.1 Manual Process Flow for Parent/Guardian and Patient (Walk-in &amp; Immunization)&#xa;Barangay Bugo Health Center" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="15" width="550" height="35" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="375" y="70" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- P1: Arrival -->
        <mxCell id="p1" value="Parent brings child to Barangay Bugo Health Center on immunization day" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="140" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- D1: Card Check -->
        <mxCell id="d1" value="Does parent have the&#xa;physical Baby's Health Record&#xa;(EPI Card)?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="325" y="225" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- P2: Search/Temp Card (NO Branch) -->
        <mxCell id="p2" value="BHW searches duplicate records or issues temporary replacement slip" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="237.5" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- P3: Queue -->
        <mxCell id="p3" value="Submit physical card at BHW triage desk and queue in waiting area" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="340" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- P4: Vitals Triage -->
        <mxCell id="p4" value="BHW conducts triage &amp; physical measurements (Weight, Length, Temp)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="425" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- D2: Fitness Check -->
        <mxCell id="d2" value="Is child cleared for&#xa;vaccination (no high fever&#xa;or illness)?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="325" y="510" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- P_Defer: Deferral (NO Branch) -->
        <mxCell id="p_defer" value="Immunization deferred; advised home care &amp; told to return next week" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="522.5" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- End_Defer -->
        <mxCell id="end_defer" value="End&#xa;(Deferred)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="645" y="615" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- P5: Proceed to Nurse -->
        <mxCell id="p5" value="Proceed to Nurse / Midwife consultation and vaccination table" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="625" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- D3: Vaccine Stock Check -->
        <mxCell id="d3" value="Is the required&#xa;vaccine available in&#xa;cold storage?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="325" y="710" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- P_Stockout: Out of Stock (NO Branch) -->
        <mxCell id="p_stockout" value="Staff informs parent of stock-out; parent turns back without vaccination" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="722.5" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- End_Stockout -->
        <mxCell id="end_stockout" value="End&#xa;(Missed / Stock-out)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="645" y="815" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- P6: Administer Vaccine -->
        <mxCell id="p6" value="Nurse/Midwife administers milestone vaccine dose to infant" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="825" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- P7: Handwriting on Card -->
        <mxCell id="p7" value="Nurse handwrites date, batch/lot no., and next return schedule on paper card" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="910" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- P8: Parent Departure -->
        <mxCell id="p8" value="Parent receives card with verbal schedule instructions and departs center" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="995" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- End_Success -->
        <mxCell id="end_success" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="375" y="1085" width="100" height="40" as="geometry" />
