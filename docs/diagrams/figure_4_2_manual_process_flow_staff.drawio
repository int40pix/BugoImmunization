<mxfile host="app.diagrams.net" modified="2026-09-22T10:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="manual_flow_staff" name="Figure 4.2 Manual Process Flow for Staff">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header Title -->
        <mxCell id="title" value="Figure 4.2 Manual Process Flow for Health Center Staff (BHW, Midwife, and Nurse)&#xa;Barangay Bugo Health Center" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="15" width="550" height="35" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="375" y="70" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- S1: Receive walk-in -->
        <mxCell id="s1" value="BHW receives walk-in parent and collects physical health record card" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="140" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- S2: Manual Search -->
        <mxCell id="s2" value="Manually flips through pages of thick Target Client List (TCL) logbook binder" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="225" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- D1: Patient Found? -->
        <mxCell id="d1" value="Is patient record&#xa;found in the&#xa;TCL binder?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="325" y="310" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- S_New: Create New Patient (NO Branch) -->
        <mxCell id="s_new" value="Handwrite new patient entry row with full demographics across TCL columns" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="322.5" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- S3: Verify Dose -->
        <mxCell id="s3" value="Verify previous immunization history &amp; identify due milestone vaccine dose" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="425" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- S4: Refrigerator Check -->
        <mxCell id="s4" value="Staff physically inspects refrigerator stock and checks paper stock card" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="510" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- D2: Vaccine Available? -->
        <mxCell id="d2" value="Are required vaccine&#xa;vials available in&#xa;cold storage?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="325" y="595" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- S_Stockout: Out of Stock (NO Branch) -->
        <mxCell id="s_stockout" value="Log stock-out on paper tally; verbally advise parent to return next week" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="607.5" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- End_Stockout -->
        <mxCell id="end_stockout" value="End&#xa;(Stock-out Logged)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="645" y="695" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- S5: Syringe Prep -->
        <mxCell id="s5" value="Retrieve vial, inspect expiry label, and prepare sterile syringe" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="710" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- S6: Administer -->
        <mxCell id="s6" value="Nurse / Midwife administers vaccine dose to the pediatric patient" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="795" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- S7: 3-Way Paper Recording -->
        <mxCell id="s7" value="Transcribe dose details manually into 3 separate paper records:&#xa;1. Child's Health Record Card&#xa;2. Target Client List (TCL) logbook&#xa;3. Daily Immunization Tally Sheet" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="285" y="880" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- S8: Paper Stock Deduction -->
        <mxCell id="s8" value="Manually deduct used vial count on the Paper Vaccine Stock Card" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="985" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- S9: Manual Date Calculation -->
        <mxCell id="s9" value="Calculate next appointment date by manually counting calendar intervals" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="1070" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- S10: Card Handover & Filing -->
        <mxCell id="s10" value="Return paper card to parent and manually file TCL binder back in cabinet" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="315" y="1155" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- End_Staff -->
        <mxCell id="end_staff" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="375" y="1240" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- EDGES -->
